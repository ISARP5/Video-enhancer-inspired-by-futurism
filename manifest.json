{
  "manifest_version": 3,
  "name": "Universal Video Enhancer Pro",
  "version": "1.2.0",
  "description": "Mejora visual en tiempo real para cualquier video HTML5. Compatible con todos los navegadores Chromium (Chrome, Brave, Edge, Opera, Arc, etc.) y optimizada para rendimiento y privacidad estricta.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir Video Enhancer"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "videoenhancerpro@rebol.io",
      "strict_min_version": "109.0"
    }
  }
}
